# Copy to supabase/functions/.env (git-ignored) and run:
#   supabase functions serve --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge Function runtime.

# Must equal private.push_settings.webhook_secret (the local seed uses this value).
PUSH_WEBHOOK_SECRET=local-development-webhook-secret

# The Firebase service account JSON as a single line. Never commit it; in production set it with
# `supabase secrets set FCM_SERVICE_ACCOUNT="$(cat service-account.json)"`.
FCM_SERVICE_ACCOUNT={"project_id":"","client_email":"","private_key":""}
